<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is copied by cloud backup or a phone-to-phone transfer (Android 12+ ignores
  allowBackup="false" for device transfer). The lock state, Pro flag and debug unlock
  must start fresh on a new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
