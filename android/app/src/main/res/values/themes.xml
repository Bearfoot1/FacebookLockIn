<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Always dark: the bold look does not change with the phone's theme. -->
    <style name="Theme.LockIn" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorSurface">@color/ink</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="android:textColorHighlight">#66FFE500</item>
    </style>

    <!-- Big yellow block button with black text. -->
    <style name="LockIn.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:minHeight">64dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">@color/on_accent</item>
        <item name="android:textSize">17sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Outlined secondary button. -->
    <style name="LockIn.Button.Outline" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="strokeColor">@color/surface_line</item>
        <item name="strokeWidth">2dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="cornerRadius">6dp</item>
    </style>

    <!-- Plain text button. -->
    <style name="LockIn.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <!-- Small yellow caps label ("MARKETPLACE LOCK-IN", "TIP"). -->
    <style name="LockIn.Label" parent="">
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">0.18</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <!-- Huge headline ("NOT TODAY.", "LOCKED IN."). -->
    <style name="LockIn.Headline" parent="">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">52sp</item>
        <item name="android:fontFamily">sans-serif-black</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:lineSpacingMultiplier">0.9</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
