<?xml version="1.0" encoding="utf-8"?>
<!-- Full-screen block overlay. Bold: near-black, huge headline, yellow accent. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:orientation="vertical"
    android:paddingStart="@dimen/overlay_padding"
    android:paddingTop="48dp"
    android:paddingEnd="@dimen/overlay_padding"
    android:paddingBottom="32dp">

    <TextView
        style="@style/LockIn.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/app_label_caps" />

    <!-- Pushes the message block toward the middle of the screen. -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/message_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/headline_text"
            style="@style/LockIn.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/overlay_title" />

        <View
            android:layout_width="@dimen/accent_bar_width"
            android:layout_height="@dimen/accent_bar_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/accent_bar" />

        <TextView
            android:id="@+id/quote_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingMultiplier="1.1"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/overlay_quote_size" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:background="@drawable/tip_card_background"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="14dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <TextView
                style="@style/LockIn.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/overlay_tip_label" />

            <TextView
                android:id="@+id/tip_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:lineSpacingMultiplier="1.1"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/count_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:fontFamily="sans-serif-medium"
        android:gravity="center"
        android:letterSpacing="0.08"
        android:textAllCaps="true"
        android:textColor="@color/text_muted"
        android:textSize="12sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/go_marketplace"
        style="@style/LockIn.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/overlay_go_marketplace" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/go_back"
        style="@style/LockIn.Button.Text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/overlay_go_back" />
</LinearLayout>
