<?xml version="1.0" encoding="utf-8"?>
<!-- Main screen. Sharp and loud: hazard stripes, huge condensed status, square toggles. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="@dimen/screen_padding">

        <app.lockin.android.HazardStripeView
            android:id="@+id/top_stripes"
            android:layout_width="match_parent"
            android:layout_height="14dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/screen_padding"
            android:paddingEnd="@dimen/screen_padding">

            <!-- Brand + live status light. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/LockIn.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/app_label_caps" />

                <TextView
                    android:id="@+id/pro_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="14dp"
                    android:background="?attr/lockinAccent"
                    android:fontFamily="sans-serif-condensed"
                    android:paddingStart="8dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="2dp"
                    android:text="@string/pro_badge"
                    android:textColor="?attr/lockinOnAccent"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <View
                    android:id="@+id/service_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/service_text"
                    style="@style/LockIn.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:textColor="@color/text_primary" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_text"
                style="@style/LockIn.Headline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp" />

            <View
                android:id="@+id/status_bar"
                android:layout_width="96dp"
                android:layout_height="8dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/accent_bar" />

            <!-- Rotating hustle quote; tap for another. -->
            <TextView
                android:id="@+id/quote_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/tip_card_background"
                android:fontFamily="sans-serif-condensed"
                android:lineSpacingMultiplier="1.05"
                android:paddingStart="22dp"
                android:paddingTop="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="16dp"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />

            <!-- Score: big blocked count. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <TextView
                    android:id="@+id/count_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-condensed"
                    android:includeFontPadding="false"
                    android:textColor="?attr/lockinAccent"
                    android:textSize="72sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/LockIn.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:lineSpacingMultiplier="1.1"
                    android:text="@string/blocked_label"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Master toggle: the whole lock. Turning it off asks for the phrase. -->
            <LinearLayout
                android:id="@+id/lock_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_active_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LockIn.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/lock_toggle_title"
                        android:textSize="24sp" />

                    <TextView
                        android:id="@+id/lock_toggle_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/lock_switch"
                    style="@style/LockIn.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/lock_toggle_title" />
            </LinearLayout>

<!-- Messenger: allowed unless the owner switches blocking on. -->
            <LinearLayout
                android:id="@+id/messenger_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_background"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/LockIn.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/messenger_title"
                        android:textSize="22sp" />

                    <TextView
                        android:id="@+id/messenger_sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />
                </LinearLayout>

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/messenger_switch"
                    style="@style/LockIn.Switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:contentDescription="@string/messenger_title" />
            </LinearLayout>

            <!-- Turn-off confirmation: type the phrase. -->
            <LinearLayout
                android:id="@+id/confirm_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_danger_background"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    style="@style/LockIn.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/confirm_label"
                    android:textColor="@color/danger" />

                <TextView
                    android:id="@+id/confirm_prompt_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <EditText
                    android:id="@+id/confirm_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:backgroundTint="@color/text_muted"
                    android:importantForAutofill="no"
                    android:inputType="text|textNoSuggestions"
                    android:minHeight="52dp"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_muted" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/cancel_off_button"
                    style="@style/LockIn.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/section_spacing"
                    android:text="@string/cancel" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/confirm_off_button"
                    style="@style/LockIn.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:enabled="false"
                    android:text="@string/confirm_off" />
            </LinearLayout>

            <!-- Shown only while the accessibility service is off. -->
            <LinearLayout
                android:id="@+id/service_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/card_danger_background"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    style="@style/LockIn.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/service_off_title"
                    android:textColor="@color/danger"
                    android:textSize="24sp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="@string/service_disabled"
                    android:textColor="@color/text_muted"
                    android:textSize="15sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/open_accessibility_button"
                    style="@style/LockIn.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/open_accessibility" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/open_marketplace_button"
                style="@style/LockIn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/open_marketplace" />

            <!-- Redirects: apps that bounce to Marketplace. Rows are added in code. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/LockIn.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/redirect_label" />

                <TextView
                    android:id="@+id/redirect_count_text"
                    style="@style/LockIn.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/redirect_intro"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/redirect_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/redirect_empty_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/redirect_empty"
                android:textColor="@color/text_muted"
                android:textSize="15sp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/add_redirect_button"
                style="@style/LockIn.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/redirect_add" />

            <!-- Themes: square swatches, Pro ones locked without Pro. Built in code. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="bottom"
                android:orientation="horizontal">

                <TextView
                    style="@style/LockIn.Title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/themes_label" />

                <TextView
                    android:id="@+id/theme_name_text"
                    style="@style/LockIn.Label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="10dp"
                android:background="@color/text_primary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/theme_list"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Pro pitch (hidden once Pro is active). -->
            <LinearLayout
                android:id="@+id/pro_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:background="@drawable/card_active_background"
                android:orientation="vertical">

                <app.lockin.android.HazardStripeView
                    android:layout_width="match_parent"
                    android:layout_height="10dp"
                    android:layout_margin="3dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="20dp">

                    <TextView
                        style="@style/LockIn.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pro_title" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:lineSpacingMultiplier="1.25"
                        android:text="@string/pro_features"
                        android:textColor="@color/text_primary"
                        android:textSize="16sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/go_pro_button"
                        style="@style/LockIn.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                style="@style/LockIn.Label"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:text="@string/footer_line"
                android:textColor="@color/surface_line" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
