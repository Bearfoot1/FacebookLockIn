<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/screen_padding"
        android:paddingTop="32dp"
        android:paddingEnd="@dimen/screen_padding"
        android:paddingBottom="@dimen/screen_padding">

        <TextView
            style="@style/LockIn.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/app_label_caps" />

        <TextView
            android:id="@+id/status_text"
            style="@style/LockIn.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp" />

        <View
            android:id="@+id/status_bar"
            android:layout_width="@dimen/accent_bar_width"
            android:layout_height="@dimen/accent_bar_height"
            android:layout_marginTop="20dp"
            android:background="@drawable/accent_bar" />

        <TextView
            android:id="@+id/intro_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingMultiplier="1.15"
            android:text="@string/intro"
            android:textColor="@color/text_muted"
            android:textSize="16sp" />

        <!-- Stats card: big blocked count. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:id="@+id/count_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:includeFontPadding="false"
                android:textColor="@color/accent"
                android:textSize="56sp" />

            <TextView
                style="@style/LockIn.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/blocked_label"
                android:textColor="@color/text_muted" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="16dp"
                android:background="@color/surface_line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:id="@+id/service_dot"
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:background="@drawable/status_dot" />

                <TextView
                    android:id="@+id/service_text"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:textColor="@color/text_primary"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_accessibility_button"
            style="@style/LockIn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/open_accessibility" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/open_marketplace_button"
            style="@style/LockIn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/open_marketplace" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/turn_on_button"
            style="@style/LockIn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:text="@string/turn_lock_on"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="24dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/turn_off_button"
            style="@style/LockIn.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/turn_lock_off" />

        <LinearLayout
            android:id="@+id/confirm_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/section_spacing"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="20dp"
            android:visibility="gone">

            <TextView
                style="@style/LockIn.Label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/confirm_label"
                android:textColor="@color/danger" />

            <TextView
                android:id="@+id/confirm_prompt_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

            <EditText
                android:id="@+id/confirm_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:importantForAutofill="no"
                android:inputType="text|textNoSuggestions"
                android:minHeight="52dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:backgroundTint="@color/surface_line" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/confirm_off_button"
                style="@style/LockIn.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:enabled="false"
                android:text="@string/confirm_off" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancel_off_button"
                style="@style/LockIn.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/section_spacing"
                android:text="@string/cancel" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
