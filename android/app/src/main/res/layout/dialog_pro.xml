<?xml version="1.0" encoding="utf-8"?>
<!-- Upgrade screen: stripes, big shout, what Pro gets you, one big button. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/ink"
    android:orientation="vertical">

    <app.lockin.android.HazardStripeView
        android:layout_width="match_parent"
        android:layout_height="14dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            style="@style/LockIn.Label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pro_title" />

        <TextView
            style="@style/LockIn.Headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/pro_headline"
            android:textSize="64sp" />

        <TextView
            android:id="@+id/pro_reason_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="sans-serif-condensed"
            android:textColor="?attr/lockinAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:lineSpacingMultiplier="1.3"
            android:text="@string/pro_features"
            android:textColor="@color/text_primary"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pro_buy_button"
            style="@style/LockIn.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pro_close_button"
            style="@style/LockIn.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/pro_not_now" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pro_dev_button"
            style="@style/LockIn.Button.Text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pro_dev_unlock"
            android:textColor="@color/danger"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
